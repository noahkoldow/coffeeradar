{
  "expo": {
    "name": "bits",
    "slug": "bits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bits.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "We read your next event to find free time and write plans you commit to.",
        "NSLocationWhenInUseUsageDescription": "We use your location to make sure you can arrive on time."
      }
    },
    "android": {
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7FB"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bits.app.android"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5666991539216529~8814610819",
          "iosAppId": "ca-app-pub-5666991539216529~5496136737",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ],
    "scheme": "bits",
    "extra": {
      "eas": {
        "projectId": "b6030b0e-c5f3-4025-9f3d-23a06de167b9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b6030b0e-c5f3-4025-9f3d-23a06de167b9"
    }
  }
}
