{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight-staging": {
      "extends": "production",
      "distribution": "store",
      "channel": "production"
    }
  },
  "submit": {
    "production": {},
    "testflight-staging": {
      "ios": {
        "ascAppId": "6801029604"
      }
    }
  }
}
