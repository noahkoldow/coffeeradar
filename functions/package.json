{
	"name": "coffee-radar-functions",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "22"
	},
	"main": "lib/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test:ai": "npm run build && node --test scripts/aiRouter.test.js scripts/aiGateway.test.js scripts/aiClientTransport.test.js ../scripts/ai-consent.test.cjs",
		"watch": "tsc -w -p tsconfig.json",
		"admin:set": "node scripts/manageAdminClaim.js set",
		"admin:unset": "node scripts/manageAdminClaim.js unset"
	},
	"dependencies": {
		"@apple/app-store-server-library": "^3.1.0",
		"firebase-admin": "^13.10.0",
		"firebase-functions": "^6.6.0",
		"node-fetch": "^3.3.2"
	},
	"devDependencies": {
		"@types/markdown-it": "^14.1.2",
		"acorn": "^8.18.0",
		"markdown-it": "^14.3.0",
		"typescript": "^5.1.3"
	}
}
