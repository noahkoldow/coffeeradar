rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Request ownership comes from verified callable authentication, never client payloads.
    match /account_deletion_requests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if false;
    }
    // ========================================================================
    // Helper Functions
    // ========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.ownerId == getUserId();
    }

    function isBusinessMember(businessId) {
      let business = get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data;

      let memberId = getUserId();

      return isSignedIn()
        && (
          business.ownerId == memberId
          || memberId in business.teamMembers.keys()
        );
    }

    function isBusinessMemberWithRole(businessId, requiredRole) {
      let business = get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data;

      let memberId = getUserId();
      let memberRole = business.teamMembers[memberId];

      return isSignedIn()
        && (
          business.ownerId == memberId
          || (
            memberId in business.teamMembers
            && (
              requiredRole == 'any'
              || memberRole in ['owner', 'admin', requiredRole]
            )
          )
        );
    }

    function hasValidBusinessData(data) {
      return data.keys().hasAll([
          'businessName',
          'category',
          'email',
          'location',
          'website',
          'ownerId',
          'verificationStatus',
          'createdAt'
        ])
        && data.businessName is string
        && data.businessName.size() > 0
        && data.category is string
        && data.email is string
        && data.location is map
        && data.location.keys().hasAll([
          'address',
          'city',
          'country'
        ])
        && data.website is string
        && data.ownerId is string
        && data.verificationStatus in [
          'pending',
          'verified',
          'rejected'
        ];
    }

    function hasValidCampaignData(data) {
      return data.keys().hasAll([
          'businessId',
          'title',
          'hook',
          'cta',
          'description',
          'category',
          'status',
          'targeting',
          'createdAt',
          'createdBy'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.hook is string
        && (data.cta is string || data.cta is map)
        && data.status in [
          'draft',
          'pending_approval',
          'approved',
          'active',
          'paused',
          'archived',
          'ended'
        ]
        && data.targeting is map
        && data.createdBy is string;
    }

    function validTextItem(items, index) {
      return items.size() <= index || (items[index] is string && items[index].size() > 0 && items[index].size() <= 80);
    }
    function validTextList(items, maximum) {
      return items is list && items.size() <= maximum
        && validTextItem(items, 0) && validTextItem(items, 1) && validTextItem(items, 2) && validTextItem(items, 3)
        && validTextItem(items, 4) && validTextItem(items, 5) && validTextItem(items, 6) && validTextItem(items, 7)
        && validTextItem(items, 8) && validTextItem(items, 9);
    }
    function validCommunityContent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.hook is string && data.hook.size() > 0 && data.hook.size() <= 300
        && data.description is string && data.description.size() > 0 && data.description.size() <= 3000
        && data.type in ['AT_HOME', 'GO_OUT', 'EVENT']
        && data.durationMin is number && data.durationMin >= 1 && data.durationMin <= 1440
        && validTextList(data.get('tags', []), 10) && validTextList(data.get('emojis', []), 6)
        && data.get('cta', '') is string && data.get('imageUrl', '') is string
        && data.get('timeOfDay', 'any') in ['any', 'morning', 'afternoon', 'evening']
        && (!('place' in data) || (data.place is map && data.place.name is string
          && data.place.name.size() > 0 && data.place.get('address', '') is string
          && (!('lat' in data.place) || (data.place.lat is number && data.place.lat >= -90 && data.place.lat <= 90))
          && (!('lng' in data.place) || (data.place.lng is number && data.place.lng >= -180 && data.place.lng <= 180))))
        && (!('event' in data) || (data.event is map
          && data.event.startAt is string && data.event.venue is string && data.event.ticketUrl is string
          && data.event.get('priceRange', '') is string));
    }

    // ========================================================================
    // User Collection
    // ========================================================================

    match /users/{userId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId;

      match /{subcollection}/{document} {
        allow read: if isSignedIn()
          && request.auth.uid == userId;
        allow write: if isSignedIn()
          && request.auth.uid == userId
          && subcollection != 'consents';
      }
    }

    // ========================================================================
    // Server-owned subscription state. Device storage and user documents cannot grant access.
    match /entitlements/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /store_transactions/{transactionId} { allow read, write: if false; }
    match /sandbox_entitlements/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /sandbox_store_transactions/{transactionId} { allow read, write: if false; }
    match /campaign_vouchers/{voucherId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Analytics Events Collection
    // ========================================================================

    match /analytics_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp is timestamp;
    }

    // ========================================================================
    // Business Submissions Collection (Legacy)
    // ========================================================================

    match /business_submissions/{submissionId} {
      function validTag(tags, index) {
        return tags.size() <= index || (tags[index] is string && tags[index].size() > 0 && tags[index].size() <= 60);
      }
      function validListing(b) {
        return b is map && b.name is string && b.name.size() >= 2 && b.name.size() <= 120
          && b.description is string && b.description.size() >= 20 && b.description.size() <= 1000
          && b.type in ['gym', 'cafe', 'restaurant', 'studio', 'venue', 'other']
          && b.place is map && b.place.name is string && b.place.name.size() > 0 && b.place.name.size() <= 120
          && b.place.address is string && b.place.address.size() > 0 && b.place.address.size() <= 500
          && b.place.lat is number && b.place.lat >= -90 && b.place.lat <= 90
          && b.place.lng is number && b.place.lng >= -180 && b.place.lng <= 180
          && b.targetTags is list && b.targetTags.size() > 0 && b.targetTags.size() <= 8
          && validTag(b.targetTags, 0) && validTag(b.targetTags, 1) && validTag(b.targetTags, 2) && validTag(b.targetTags, 3)
          && validTag(b.targetTags, 4) && validTag(b.targetTags, 5) && validTag(b.targetTags, 6) && validTag(b.targetTags, 7);
      }
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['business', 'submittedBy', 'submittedByEmail', 'status', 'submittedAt', 'reviewNote'])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt is timestamp
        && validListing(request.resource.data.business)
        && request.resource.data.business.isVerified == false;

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
        );

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================================================
    // Businesses Collection + nested rules (unchanged)
    // ========================================================================

    match /businesses/{businessId} {
      allow read: if (isSignedIn() && request.auth.uid == businessId && !exists(/databases/$(database)/documents/businesses/$(businessId)))
        || resource.data.verificationStatus == 'verified'
        || isBusinessMember(businessId)
        || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidBusinessData(request.resource.data)
        && request.resource.data.teamMembers is map
        && request.resource.data.verificationStatus == 'pending';

      allow update: if hasValidBusinessData(request.resource.data)
        && (isAdmin() || (isBusinessOwner(businessId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.verificationStatus == resource.data.verificationStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'businessName', 'category', 'email', 'location', 'website', 'phone',
            'description', 'logo', 'logoUrl', 'coverImageUrl', 'socialLinks', 'updatedAt', 'teamMembers'
          ])));

      allow delete: if isAdmin();

      // Allow any signed-in user to increment metrics/updatedAt only
      allow update: if isBusinessMember(businessId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['metrics', 'updatedAt']);

      match /campaigns/{campaignId} {
        allow read: if isBusinessMember(businessId) || isAdmin()
          || (resource.data.status == 'active'
            && get(/databases/$(database)/documents/businesses/$(businessId)).data.verificationStatus == 'verified');

        // Draft validation and approval queues are transactional server operations.
        allow create: if false;

        allow update: if isAdmin() || (isBusinessMemberWithRole(businessId, 'editor')
          && hasValidCampaignData(request.resource.data)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'publishedAt', 'pausedAt', 'resumedAt', 'archivedAt', 'endedAt', 'deletedAt'])
          && ((resource.data.status in ['active', 'approved'] && request.resource.data.status == 'paused')
            || (resource.data.status in ['approved', 'paused'] && request.resource.data.status == 'active')
            || request.resource.data.status in ['archived', 'ended']));

        allow delete: if isBusinessOwner(businessId)
          || isAdmin();

        match /approvals/{approvalId} {
          allow read: if isAdmin()
            || (
              isBusinessMember(businessId)
              && get(
                /databases/$(database)/documents/businesses/$(businessId)/campaigns/$(campaignId)
              ).data.createdBy == request.auth.uid
            );

          allow create: if false;

          allow update: if isAdmin()
            && (
              request.resource.data.status in [
                'approved',
                'rejected'
              ]
              || request.resource.data.status
                == resource.data.status
            );

          allow delete: if isAdmin();
        }

        match /metrics/{metricId} {
          allow read: if isBusinessMember(businessId);

          allow create: if isSignedIn()
            && isBusinessMember(businessId)
            && request.resource.data.type in [
              'impression',
              'click',
              'conversion'
            ]
            && request.resource.data.timestamp is timestamp
            && (
              request.resource.data.type == 'impression'
              || (
                request.resource.data.type == 'click'
                && request.resource.data.userId is string
                && request.resource.data.userId == request.auth.uid
              )
              || (
                request.resource.data.type == 'conversion'
                && request.resource.data.value is number
                && request.resource.data.userId is string
                && request.resource.data.userId == request.auth.uid
              )
            );

          allow update, delete: if isAdmin();
        }

        match /targeting_logs/{logId} {
          allow read: if isBusinessMember(businessId);

          allow create: if isSignedIn()
            && isBusinessMember(businessId)
            && request.resource.data.timestamp is timestamp
            && request.resource.data.matched is bool;

          allow update, delete: if isAdmin();
        }
      }

      match /team_members/{memberId} {
        allow read: if isBusinessMember(businessId);

        allow create: if (
            isBusinessOwner(businessId)
            || isAdmin()
          )
          && request.resource.data.role in [
            'viewer',
            'editor',
            'admin'
          ]
          && request.resource.data.joinedAt is timestamp;

        allow update: if isBusinessOwner(businessId)
          || (
            isAdmin()
            && request.resource.data.role in [
              'viewer',
              'editor',
              'admin'
            ]
          );

        allow delete: if isBusinessOwner(businessId)
          || isAdmin();
      }

      match /billing/{billingId} {
        allow read: if isBusinessOwner(businessId)
          || isAdmin();

        allow create: if false;

        allow update: if isAdmin();

        allow delete: if isAdmin();

        match /invoices/{invoiceId} {
          allow read: if isBusinessOwner(businessId)
            || isAdmin();

          allow create, update, delete: if isAdmin();
        }
      }

      match /verification_docs/{docId} {
        allow read: if isBusinessOwner(businessId)
          || isAdmin();

        allow create: if isBusinessOwner(businessId)
          && request.resource.data.type in [
            'id_photo',
            'business_license',
            'address_proof'
          ]
          && request.resource.data.uploadedAt is timestamp;

        allow update: if isAdmin();

        allow delete: if (
            isBusinessOwner(businessId)
            && resource.data.status == 'pending'
          )
          || isAdmin();
      }
    }

    // Canonical business account review is a separate operator workflow.
    match /business_verification_requests/{businessId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.requestedBy == request.auth.uid);
      allow write: if false;
    }

    // ========================================================================
    // Activities collection (DB-first content store)
    // ========================================================================

    match /community_ideas/{ideaId} {
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('reviewerId', null) == null
        && request.resource.data.get('reviewedAt', null) == null
        && request.resource.data.get('reviewNote', null) == null
        && validCommunityContent(request.resource.data)
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedAtTs is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.hook is string
        && request.resource.data.hook.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.type in [
          'AT_HOME',
          'GO_OUT',
          'EVENT'
        ]
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'hook', 'description', 'type', 'durationMin', 'cta', 'tags', 'emojis', 'place', 'event', 'imageUrl', 'timeOfDay'])
          && validCommunityContent(request.resource.data)
          && request.resource.data.submittedBy == resource.data.submittedBy
          && request.resource.data.submittedAt == resource.data.submittedAt
          && request.resource.data.submittedAtTs == resource.data.submittedAtTs
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || (
          // Any signed-in user may increment completion stats on approved ideas.
          isSignedIn()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completionCount', 'helpMinutes'])
          && request.resource.data.completionCount is number
          && request.resource.data.helpMinutes is number
          && request.resource.data.completionCount >= resource.data.get('completionCount', 0)
          && request.resource.data.helpMinutes >= resource.data.get('helpMinutes', 0)
        );

      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /activity_chats/{threadId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.id == threadId
        && request.resource.data.suggestionId is string
        && request.resource.data.suggestionId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.participantCount is number
        && request.resource.data.participantCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.regionLabel is string
          || request.resource.data.regionLabel == null
        );

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'regionLabel', 'participantCount', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.participantCount is number
        && request.resource.data.participantCount >= 0
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.regionLabel is string
          || request.resource.data.regionLabel == null
        );

      allow delete: if false;

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && participantId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 32
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if isSignedIn()
          && participantId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 32
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 32
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /direct_chats/{threadId} {
      function isDirectChatParticipant() {
        return isSignedIn()
          && resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isDirectChatParticipant();

      allow create: if isSignedIn()
        && request.resource.data.id == threadId
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantNames is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.contextThreadId is string
          || request.resource.data.contextThreadId == null
        )
        && (
          request.resource.data.contextTitle is string
          || request.resource.data.contextTitle == null
        );

      allow update: if isDirectChatParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantNames is map
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.contextThreadId is string
          || request.resource.data.contextThreadId == null
        )
        && (
          request.resource.data.contextTitle is string
          || request.resource.data.contextTitle == null
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isDirectChatParticipant();
        allow create: if isSignedIn()
          && isDirectChatParticipant()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 32
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // ========================================================================
    // Affiliates catalog (public read, admin-managed)
    // ========================================================================

    match /affiliates/{affiliateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // Vouchers (server-issued) and Conversions (server-recorded)
    // ========================================================================

    match /vouchers/{voucherId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /conversions/{conversionId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // Approval queue and metrics (unchanged)
    // ========================================================================

    match /approval_queue/{approvalId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.kind == 'community_idea'
        && request.resource.data.ideaId == approvalId
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedAt is timestamp
        && (
          request.resource.data.submittedByEmail is string
          || request.resource.data.submittedByEmail == null
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.hook is string
        && request.resource.data.hook.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.type in [
          'AT_HOME',
          'GO_OUT',
          'EVENT'
        ]
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0
        && request.resource.data.tags is list
        && validTextList(request.resource.data.tags, 10)
        && getAfter(/databases/$(database)/documents/community_ideas/$(approvalId)).data.submittedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/community_ideas/$(approvalId)).data.status == 'pending'
        && request.resource.data.hasLocation is bool
        && request.resource.data.hasImage is bool;
      allow update: if isAdmin()
        && request.resource.data.status in [
          'approved',
          'rejected'
        ];
      allow delete: if isAdmin();
    }

    match /campaign_metrics_daily/{date} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /business_directory/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // Catch-all (deny)
    // ========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
